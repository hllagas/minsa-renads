# Plantilla de variables de entorno. Copiar a .env y completar.
# En Railway, definir estas variables en el panel del servicio.

# --- Comunes ---
SECRET_KEY=cambia-esto-por-una-clave-secreta
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# API
PAGE_SIZE=20

# --- Almacenamiento documental: Google Cloud Storage (GCS) ---
# Autenticación KEYLESS (sin claves JSON de service account):
#   1. El usuario/CI corre: gcloud auth application-default login
#   2. El principal ADC debe tener el rol
#      roles/iam.serviceAccountTokenCreator sobre GCS_SIGNING_SA.
#   3. No se generan ni almacenan claves de SA
#      (constraints/iam.disableServiceAccountKeyCreation lo bloquea).
# Con GCS_ENABLED=False (default) se usa el stub por referencia externa.
GCS_ENABLED=True
GCS_PROJECT_ID=renads-cloud
# Bucket por entorno: dev -> renads-cloud-media-dev, prod -> renads-cloud-media-prod
GCS_BUCKET_NAME=renads-cloud-media-dev
GCS_SIGNING_SA=renads-storage@renads-cloud.iam.gserviceaccount.com
# Prefijo opcional para organizar las keys de los objetos
GCS_OBJECT_PREFIX=
# Vigencia del signed URL de descarga, en segundos (default 900 = 15 min)
GCS_SIGNED_URL_EXPIRATION=900
# Tamaño máximo de subida, en bytes (default 26214400 = 25 MiB)
GCS_MAX_UPLOAD_BYTES=26214400

# --- Almacenamiento de imágenes: django-storages (GS_*) ---
# Backend Django Storage (STORAGES["default"]) para los ImageField de logos de las
# 5 entidades (universidad, gobierno regional, órgano regional, unidad ejecutora,
# IPRESS). Solo se activa en producción cuando GCS_ENABLED=True (ver
# config/settings/prod.py); en dev se usa FileSystemStorage y estas vars se ignoran.
# Autenticación: la MISMA keyless de GCS (ADC + impersonación de GCS_SIGNING_SA vía
# IAM SignBlob). NO se usan claves JSON de service account. Sube al MISMO bucket
# privado bajo el prefijo GS_LOCATION (separado de GCS_OBJECT_PREFIX de los PDFs).
# Bucket privado (UBLA + PAP enforced): GS_DEFAULT_ACL=None y GS_QUERYSTRING_AUTH=True
# son obligatorios (nunca ACL pública; .url devuelve un signed URL V4 efímero).
# Por defecto GS_BUCKET_NAME/GS_PROJECT_ID reutilizan GCS_BUCKET_NAME/GCS_PROJECT_ID.
GS_BUCKET_NAME=renads-cloud-media-dev
GS_PROJECT_ID=renads-cloud
# Prefijo/carpeta raíz de las imágenes en el bucket (distinto de GCS_OBJECT_PREFIX)
GS_LOCATION=logos
# Firma de URLs en .url (True = signed URL V4 privado); no cambiar en bucket privado
GS_QUERYSTRING_AUTH=True
# Vigencia del signed URL de .url, en segundos (default = GCS_SIGNED_URL_EXPIRATION)
GS_EXPIRATION=900
# Sobrescribir binarios con el mismo nombre (False = renombra para evitar colisiones)
GS_FILE_OVERWRITE=False

# --- Almacenamiento documental y de imágenes: Cloudflare R2 (S3-compatible) ---
# R2 es S3-compatible: se usa boto3 (documentos PDF) y storages.backends.s3
# (ImageField de logos) contra el endpoint de R2 con region_name="auto" y firma
# s3v4. R2 tiene PRECEDENCIA sobre GCS. Con R2_ENABLED=False (default) el sistema
# usa GCS (si está habilitado) o el stub; los ImageField usan FileSystemStorage.
# Bucket privado: la lectura es siempre vía presigned URL de corta duración.
R2_ENABLED=False
# Account ID de Cloudflare (parte del endpoint S3)
R2_ACCOUNT_ID=
# Access key y secret del token de API de R2 (NO versionar secretos reales)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket del entorno
R2_BUCKET=renads-media
# Endpoint S3 de R2: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Prefijo opcional para organizar las keys de los documentos (PDFs)
R2_OBJECT_PREFIX=
# Vigencia del presigned URL de descarga, en segundos (default 900 = 15 min)
R2_SIGNED_URL_EXPIRATION=900
# Tamaño máximo de subida, en bytes (default 26214400 = 25 MiB)
R2_MAX_UPLOAD_BYTES=26214400

# --- Procesamiento de PDFs: Google Cloud Document AI (OCR genérico) ---
# Todo PDF adjuntado se procesa para extraer su texto (documento.texto_extraido).
# Misma auth KEYLESS que GCS (ADC + impersonación de GCS_SIGNING_SA).
# Es BEST-EFFORT: con DOCAI_ENABLED=False (default) o ante fallo, la subida NO se
# bloquea y texto_extraido queda vacío.
DOCAI_ENABLED=False
# Proyecto del processor (por defecto reutiliza GCS_PROJECT_ID)
DOCAI_PROJECT_ID=renads-cloud
# Región del processor: us | eu
DOCAI_LOCATION=us
# ID del processor de Document OCR ya creado en el proyecto (obligatorio si DOCAI_ENABLED)
DOCAI_PROCESSOR_ID=

# --- Correo electrónico (notificaciones — RN-22 onboarding del interno) ---
# En dev el backend por defecto es consola (django...console.EmailBackend).
# En prod se usa SMTP; completar las credenciales del proveedor:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@renads.minsa.gob.pe

# --- Producción (Railway) ---
# Seleccionar settings de producción:
# DJANGO_SETTINGS_MODULE=config.settings.prod
# Base de datos PostgreSQL (la provee Railway):
# DATABASE_URL=postgresql://user:password@host:port/dbname
# Dominios del servicio (CSRF):
# CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app
# Redirección HTTPS (Railway ya hace TLS termination):
# SECURE_SSL_REDIRECT=True
