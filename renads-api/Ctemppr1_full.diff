+@transaction.atomic
+def actualizar_registro_campo_clinico(
+    *, registro: ClinicalFieldRegistration, datos: dict, usuario
+) -> ClinicalFieldRegistration:
+    """Actualiza (CONAPRES) un registro de campos clínicos.
