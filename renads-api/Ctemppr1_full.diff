+                        auto_created=True,
+                        primary_key=True,
+                        serialize=False,
+                        verbose_name="ID",
+                    ),
+                ),
+                (
+                    "nombre",
+                    models.CharField(
+                        help_text="Nombre del órgano",
+                        max_length=255,
+                        verbose_name="nombre",
+                    ),
+                ),
+                (
+                    "estado",
+                    models.BooleanField(
+                        default=True,
+                        help_text="Indica si está activo",
+                        verbose_name="estado",
+                    ),
+                ),
+            ],
+            options={
+                "verbose_name": "órgano",
+                "verbose_name_plural": "órganos",
+                "db_table": "organo",
+            },
+        ),
+        # ----------------------------------------------------------------
+        # Paso 2 — Seed de los 4 registros canónicos
+        # ----------------------------------------------------------------
+        migrations.RunPython(seed_organs, migrations.RunPython.noop),
+        # ----------------------------------------------------------------
+        # Paso 3 — Agregar columna FK nullable temporal en `tipo_organo`
+        # ----------------------------------------------------------------
+        migrations.AddField(
+            model_name="organtype",
+            name="organo_nuevo",
+            field=models.ForeignKey(
+                to="convenios.Organ",
+                on_delete=django.db.models.deletion.PROTECT,
+                db_column="organo_nuevo_id",
+                null=True,
+                related_name="+",
+            ),
+        ),
