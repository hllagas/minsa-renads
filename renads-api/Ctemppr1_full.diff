+def _detalle_fk(rel, *campos: str):
+    """Detalle legible de una FK (o ``None``): ``{id, <campos…>}``.
+
+    Permite que los listados del frontend muestren nombres sin resolver ids.
+    """
+    if rel is None:
+        return None
+    detalle = {"id": rel.id}
+    for campo in campos:
+        detalle[campo] = getattr(rel, campo, None)
+    return detalle
