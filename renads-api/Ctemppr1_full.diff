+                ),
+            ),
+        ),
+        # ----------------------------------------------------------------
+        # Paso 9 — Reafirmar unique_together sobre el campo FK renombrado
+        # ----------------------------------------------------------------
+        migrations.AlterUniqueTogether(
+            name="organtype",
+            unique_together={("organo", "codigo")},
+        ),
